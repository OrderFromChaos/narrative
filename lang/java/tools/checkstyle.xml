<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    The naming checks of narrative-java (P01, P09) and the parameter limit (P03). javachecks.py gives
    each check a NAR code from CHECKSTYLE_CODES. GTNH spotless decides layout, so no layout check is
    here.

    func_*, field_* and p_* are SRG and MCP names of Minecraft 1.7.10. An override keeps them.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <!-- set by narrative.init.gradle, so an unchanged file is not checked again -->
    <property name="cacheFile" value="${narrative.checkstyleCache}"/>
    <module name="TreeWalker">
        <module name="MethodName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|func_\d+_\w+)$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|field_\d+_\w+)$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|p_\w+_|_)$"/>
            <property name="ignoreOverridden" value="true"/>
        </module>
        <module name="LambdaParameterName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|_)$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|_)$"/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="format" value="^([a-z][a-zA-Z0-9]*|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*|_)$"/>
        </module>
        <module name="StaticVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName"/>
        <module name="TypeName"/>
        <module name="PackageName"/>
        <module name="ParameterNumber">
            <property name="max" value="3"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>
    </module>
</module>
