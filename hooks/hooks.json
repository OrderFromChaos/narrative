{
  "description": "Narrative procedures: no filtered verify.py output, no checks run by hand, verify.py and the review lists before a turn ends, and the skills loaded again after compaction",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" pre-tool",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" post-tool",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" stop",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session-start",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
